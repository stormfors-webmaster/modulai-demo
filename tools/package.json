{
	"name": "webflow-sync-tools",
	"version": "1.0.0",
	"description": "Tools for syncing Markdown blog posts between GitHub and Webflow CMS",
	"private": true,
	"type": "module",
	"scripts": {
		"sync": "node sync-webflow.js",
		"sync:all": "node sync-webflow.js --all",
		"sync:dry": "node sync-webflow.js --dry-run --all",
		"validate": "node validate-frontmatter.js",
		"test-sync": "node testing/test-sync.js",
		"test": "node --test test/**/*.test.js",
		"test:watch": "node --test --watch test/**/*.test.js",
		"fetch-post": "node fetch-modulai-post.js",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check --write .",
		"format": "npx @biomejs/biome format --write ."
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-gfm": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"unified": "^11.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
