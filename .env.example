# Environment Variables for Webflow CMS Sync
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# REQUIRED: Webflow API Credentials
# =============================================================================

# Webflow API Token (64 hexadecimal characters)
# Get from: Webflow Dashboard > Site Settings > Apps & Integrations > API Access
WEBFLOW_TOKEN=your_webflow_api_token_here

# Webflow Collection ID (24 hexadecimal characters)
# Get from: Webflow CMS > Collection Settings or fetch-schema.js output
WEBFLOW_COLLECTION_ID=your_collection_id_here

# =============================================================================
# OPTIONAL: Webflow Configuration
# =============================================================================

# Webflow Site ID (24 hexadecimal characters)
# Not required for most operations but useful for reference
# WEBFLOW_SITE_ID=your_site_id_here

# =============================================================================
# OPTIONAL: GitHub Configuration (auto-populated in GitHub Actions)
# =============================================================================

# GitHub Personal Access Token (for local testing of writeback)
# Only needed if you want to test repository_dispatch locally
# GITHUB_TOKEN=your_github_token_here

# Repository in owner/repo format
# Auto-set in GitHub Actions as GITHUB_REPOSITORY
# GH_REPOSITORY=owner/repo

# =============================================================================
# OPTIONAL: Logging Configuration
# =============================================================================

# Log level: debug, info, warn, error
# Default: info
# LOG_LEVEL=info

# Log format: json or text
# Default: text (json in CI environments)
# LOG_FORMAT=text

# =============================================================================
# Token Rotation Instructions
# =============================================================================
# If your Webflow token is compromised:
# 1. Log into Webflow Dashboard
# 2. Go to Site Settings > Apps & Integrations > API Access
# 3. Revoke the old token
# 4. Generate a new token
# 5. Update this file (local) and GitHub Secrets (Actions)
