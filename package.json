{
	"name": "webflow-sync-tools",
	"version": "1.0.0",
	"description": "Tools for syncing Markdown blog posts between GitHub and Webflow CMS",
	"private": true,
	"type": "module",
	"scripts": {
		"sync": "node tools/sync-webflow.js",
		"sync:all": "node tools/sync-webflow.js --all",
		"sync:dry": "node tools/sync-webflow.js --dry-run --all",
		"validate": "node tools/validate-frontmatter.js",
		"test-sync": "node tools/testing/test-sync.js",
		"test": "node --test tools/test/unit/**/*.test.js",
		"test:integration": "node --test tools/test/integration/**/*.test.js",
		"test:all": "node --test tools/test/**/*.test.js",
		"test:watch": "node --test --watch tools/test/**/*.test.js",
		"fetch-post": "node tools/fetch-modulai-post.js",
		"lint": "npx @biomejs/biome check tools/",
		"lint:fix": "npx @biomejs/biome check --write tools/",
		"format": "npx @biomejs/biome format --write tools/"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-gfm": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"unified": "^11.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
